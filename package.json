{
  "name": "recordtypes-utility",
  "version": "1.8.0",
  "description": "Salesforce Record Types Utility",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dschach/record-types.git"
  },
  "author": "dschach",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "build": ". scripts/packagedev/build.sh",
    "codeanalyzer:config": "echo 'y' | sf code-analyzer config --include-unmodified-rules --rule-selector all --config-file code-analyzer.yml --output-file code-analyzer.yml",
    "devhub-x2od": "sf config set target-dev-hub=x2od",
    "docs:setup": "sh doc-assets/setupApexDox.sh",
    "orginit": ". scripts/orginit.sh",
    "precommit": "lint-staged",
    "prepare": "husky",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:apex:verify": "prettier --list-different \"force-app/**/*.{cls,trigger}\"",
    "prettier:docs": "prettier --write \"doc*/*.{html,css}\"",
    "prettier:verify": "prettier --list-different \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prune": "git branch | grep -v \"main\" | xargs git branch -D",
    "updateHighlight": "sh doc-assets/updateHighlight.sh"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.2",
    "@x2od/prettier-config": "^0.7.0",
    "highlightjs-apex": "^1.66.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.3",
    "marked": "^18.3.0",
    "node-jq": "^6.3.1",
    "prettier": "^3.10.1",
    "prettier-plugin-apex": "^2.4.0"
  },
  "allowScripts": {
    "node-jq@6.3.1": true
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": "prettier --write"
  }
}
