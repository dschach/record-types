{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>x2od/.github:renovate.jsonc"],
  "packageRules": [],
  "major": {
    "autoApprove": false,
    "automerge": false,
    "addLabels": ["renovate", "major"]
  },
  "minor": {
    "autoApprove": true,
    "automerge": false,
    "addLabels": ["renovate", "minor"]
  },
  "patch": {
    "autoApprove": true,
    "automerge": false,
    "addLabels": ["renovate", "patch"]
  },
  "dependencyDashboardAutoclose": true,
  "lockFileMaintenance": {
    "enabled": false
  },
  "configWarningReuseIssue": false
}
